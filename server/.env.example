# server/.env.example
# Copy this to .env and fill in real credentials. Do NOT commit real secrets to git.

# REQUIRED (server will exit on startup if any are missing):
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/nova-ai?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional / agent-specific (leave blank or remove if unused):
# CHROMA_URL=http://localhost:8000
# CLIENT_URL=http://localhost:5173
# JWT_EXPIRES_IN=7d

# Firebase service account (if using Firebase auth/admin SDK)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Email (nodemailer)
# EMAIL_USER=your-email@example.com
# EMAIL_APP_PASSWORD=app-password

# Google OAuth (calendar, search, etc.)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# OpenWeather
# OPENWEATHER_API_KEY=...

# Google Custom Search
# GOOGLE_SEARCH_API_KEY=...
# GOOGLE_SEARCH_ENGINE_ID=...

# WhatsApp (set WHATSAPP_ENABLED=true to enable)
# WHATSAPP_ENABLED=false
# WHATSAPP_SESSION_PATH=./whatsapp-session
