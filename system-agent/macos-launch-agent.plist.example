<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nova.system-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_NODE_PATH</string>
    <string>REPLACE_AGENT_DIRECTORY/src/index.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_AGENT_DIRECTORY</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/nova-system-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nova-system-agent.err</string>
</dict>
</plist>